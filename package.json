{
  "name": "counsel-asia",
  "version": "0.1.0",
  "description": "Cost-optimized multi-agent build orchestrator for Asian cloud models. Kimi (Moonshot) orchestrates; DeepSeek and Qwen build; hard dollar budgets on every task.",
  "type": "module",
  "bin": {
    "counsel-asia": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "simple-git": "^3.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
